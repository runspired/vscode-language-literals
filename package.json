{
  "name": "language-literals",
  "publisher": "sissel",
  "displayName": "Language Literals",
  "description": "Syntax highlighting support for tagged literals",
  "version": "0.0.3",
  "icon": "logo.png",
  "author": "Νίκος Σαβίδης <n.savvidis@gmx.com>",
  "license": "MIT",
  "main": "./extension.js",
  "keywords": [
    "javascript",
    "typescript",
    "tagged",
    "template",
    "embedded"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/panoply/vscode-language-literals.git"
  },
  "bugs": {
    "url": "https://github.com/panoply/vscode-language-literals/issues"
  },
  "engines": {
    "vscode": "^1.44.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "scripts": {
    "build": "vsce package --no-dependencies"
  },
  "contributes": {
    "configuration": {
      "title": "Language Literals",
      "properties": {
        "languageLiterals.region.background.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Highlight the background of tagged template literal regions to help differentiate them from surrounding code."
        },
        "languageLiterals.region.background.color": {
          "type": "string",
          "default": "rgba(128, 128, 128, 0.08)",
          "description": "Background color applied to tagged template literal regions. Accepts any CSS color value (e.g. \"rgba(0, 0, 0, 0.05)\" or \"#00000010\")."
        },
        "languageLiterals.region.background.wholeLine": {
          "type": "boolean",
          "default": true,
          "description": "Extend the background highlight to the full width of each line in the region."
        }
      }
    },
    "grammars": [
      {
        "injectTo": [
          "source.js",
          "source.js.jsx",
          "source.jsx",
          "source.ts",
          "source.tsx",
          "text.html.basic",
          "text.html.derivative",
          "text.html.markdown"
        ],
        "scopeName": "inline.template-language-literals",
        "path": "./syntax/grammar.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.css": "css",
          "meta.embedded.block.markup": "html",
          "meta.embedded.block.xml": "xml",
          "meta.embedded.block.yaml": "yaml",
          "meta.embedded.block.js": "javascript",
          "meta.embedded.block.json": "json",
          "meta.embedded.block.jsonc": "jsonc",
          "meta.embedded.block.less": "less",
          "meta.embedded.block.md": "markdown",
          "meta.embedded.block.scss": "scss",
          "meta.embedded.block.ts": "typescript",
          "meta.embedded.block.tsx": "typescriptreact"
        }
      },
      {
        "injectTo": [
          "source.js",
          "source.js.jsx",
          "source.jsx",
          "source.ts",
          "source.tsx",
          "text.html.basic",
          "text.html.derivative",
          "text.html.markdown"
        ],
        "scopeName": "inline.template-tagged-languages.injection",
        "path": "./syntax/injection.tmLanguage.json",
        "embeddedLanguages": {
          "meta.template.expression.ts": "typescript"
        }
      }
    ]
  }
}
